# HopSpot PostgreSQL Backend Configuration

# Server Port
PORT=3001

# PostgreSQL Connection String
# Examples:
# Local: postgresql://postgres:postgres@localhost:5432/hopspot
# Neon / Supabase: postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hopspot

# Alternatively, configure individual PostgreSQL parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=hopspot
# PGSSL=false
